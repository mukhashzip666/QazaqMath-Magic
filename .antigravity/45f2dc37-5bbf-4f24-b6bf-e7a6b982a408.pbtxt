        instruction: "import React from \'react\';\nimport { X, Sparkles, CheckCircle2, Lightbulb } from \'lucide-react\';\n\ninterface RulesModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const RulesModal: React.FC<RulesModalProps> = ({ isOpen, onClose }) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm animate-in fade-in duration-200\">\n      <div className=\"w-full max-w-lg rounded-2xl glass-panel-elevated border border-purple-500/40 p-6 shadow-2xl relative\">\n        <button\n          onClick={onClose}\n          aria-label=\"\320\226\320\260\320\261\321\203\"\n          className=\"absolute top-4 right-4 p-2 rounded-lg bg-slate-800 text-slate-400 hover:text-white transition-colors cursor-pointer\"\n        >\n          <X className=\"w-4 h-4\" />\n        </button>\n\n        <div className=\"flex items-center gap-2 mb-4\">\n          <div className=\"p-2 rounded-xl bg-purple-500/20 text-purple-300\">\n            <Sparkles className=\"w-5 h-5 text-purple-400\" />\n          </div>\n          <h3 className=\"text-lg font-bold text-slate-100 font-magic\">\n            \302\253\320\241\320\270\322\233\321\213\321\200\320\273\321\213 \320\272\320\265\321\201\321\202\320\265\302\273 \320\265\321\200\320\265\320\266\320\265\321\201\321\226\n          </h3>\n        </div>\n\n        <div className=\"space-y-4 text-xs sm:text-sm text-slate-300 leading-relaxed mb-6\">\n          <div className=\"flex items-start gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800\">\n            <CheckCircle2 className=\"w-5 h-5 text-amber-400 shrink-0 mt-0.5\" />\n            <div>\n              <strong className=\"text-white block mb-0.5\">1-\322\233\320\260\320\264\320\260\320\274: \320\241\320\260\320\275 \321\202\320\260\322\243\320\264\320\260\322\243\321\213\320\267</strong>\n              1 \320\274\320\265\320\275 31 \320\260\321\200\320\260\320\273\321\213\322\223\321\213\320\275\320\264\320\260\322\223\321\213 \320\272\320\265\320\267 \320\272\320\265\320\273\320\263\320\265\320\275 \320\261\321\226\321\200 \320\261\322\257\321\202\321\226\320\275 \321\201\320\260\320\275\320\264\321\213 \320\276\320\271\320\273\320\260\320\277, \320\266\320\260\320\264\321\213\322\243\321\213\320\267\320\264\320\260 \320\274\321\213\322\233\321\202\320\260\320\277 \321\201\320\260\322\233\321\202\320\260\322\243\321\213\320\267.\n            </div>\n          </div>\n\n          <div className=\"flex items-start gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800\">\n            <CheckCircle2 className=\"w-5 h-5 text-cyan-400 shrink-0 mt-0.5\" />\n            <div>\n              <strong className=\"text-white block mb-0.5\">2-\322\233\320\260\320\264\320\260\320\274: \320\221\320\260\322\223\320\260\320\275\320\264\320\260\321\200\320\264\321\213 \321\202\320\265\320\272\321\201\320\265\321\200\321\226\322\243\321\226\320\267</strong>\n              \320\255\320\272\321\200\320\260\320\275\320\264\320\260\322\223\321\213 5 \320\261\320\260\322\223\320\260\320\275\320\264\321\213 \322\233\320\260\321\200\320\260\320\277 \321\210\321\213\322\223\321\213\322\243\321\213\320\267. \320\241\321\226\320\267 \320\276\320\271\320\273\320\260\322\223\320\260\320\275 \321\201\320\260\320\275 \320\261\320\260\321\200 \320\261\320\260\322\223\320\260\320\275\320\264\320\260\321\200\320\264\321\213\322\243 \320\260\321\201\321\202\321\213\320\275\320\264\320\260\322\223\321\213 \302\253\320\234\320\265\320\275\321\226\322\243 \321\201\320\260\320\275\321\213\320\274 \320\276\321\201\321\213\320\275\320\264\320\260\302\273 \320\261\320\260\321\202\321\213\321\200\320\274\320\260\321\201\321\213\320\275 \320\261\320\260\321\201\321\213\320\277 \320\261\320\265\320\273\320\263\321\226\320\273\320\265\322\243\321\226\320\267.\n            </div>\n          </div>\n\n          <div className=\"flex items-start gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800\">\n            <CheckCircle2 className=\"w-5 h-5 text-purple-400 shrink-0 mt-0.5\" />\n            <div>\n              <strong className=\"text-white block mb-0.5\">3-\322\233\320\260\320\264\320\260\320\274: \320\241\320\260\320\275\320\264\321\213 \320\261\321\226\320\273\321\203</strong>\n              \302\253\320\241\320\260\320\275\320\264\321\213 \320\261\321\226\320\273\321\203 \342\234\250\302\273 \320\261\320\260\321\202\321\213\321\200\320\274\320\260\321\201\321\213\320\275 \320\261\320\260\321\201\321\213\322\243\321\213\320\267! \320\222\320\270\321\200\321\202\321\203\320\260\320\273\320\264\321\213 \320\241\320\270\322\233\321\213\321\200\321\210\321\213 \321\201\321\226\320\267\320\264\321\226\322\243 \320\276\320\271\320\273\320\260\322\223\320\260\320\275 \321\201\320\260\320\275\321\213\322\243\321\213\320\267\320\264\321\213 \320\261\321\226\321\200\320\264\320\265\320\275 \320\266\320\260\321\200\320\270\321\217\320\273\320\260\320\277, \322\233\320\260\320\273\320\260\321\201\320\260\322\243\321\213\320\267 \320\276\320\275\321\213\322\243 \320\274\320\260\321\202\320\265\320\274\320\260\321\202\320\270\320\272\320\260\320\273\321\213\322\233 \321\201\321\213\321\200\321\213\320\275 \320\260\321\210\321\213\320\277 \320\261\320\265\321\200\320\265\320\264\321\226!\n            </div>\n          </div>\n\n          <div className=\"p-3 rounded-xl bg-purple-950/40 border border-purple-800/40 text-xs text-purple-200 flex items-center gap-2\">\n            <Lightbulb className=\"w-4 h-4 text-amber-400 shrink-0\" />\n            <span>\n              \320\232\320\265\322\243\320\265\321\201: \320\221\322\261\320\273 \321\204\320\276\320\272\321\203\321\201\321\202\321\213 \320\264\320\276\321\201\321\202\320\260\321\200\321\213\322\243\321\213\320\267\322\223\320\260 \320\275\320\265\320\274\320\265\321\201\320\265 \321\201\321\213\320\275\321\213\320\277\321\202\320\260\321\201\321\202\320\260\321\200\321\213\322\243\321\213\320\267\322\223\320\260 \322\233\320\260\322\223\320\260\320\267\322\223\320\260 \320\266\320\260\320\267\321\213\320\277 \320\272\323\251\321\200\321\201\320\265\321\202\321\226\320\277, \320\276\320\273\320\260\321\200\320\264\321\213 \321\202\320\260\322\243\322\223\320\260\320\273\320\264\321\213\321\200\320\260 \320\260\320\273\320\260\321\201\321\213\320\267!\n            </span>\n          </div>\n        </div>\n\n        <div className=\"text-right\">\n          <button\n            onClick={onClose}\n            className=\"px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs sm:text-sm transition-colors cursor-pointer\"\n          >\n            \320\242\322\257\321\201\321\226\320\275\321\226\320\272\321\202\321\226, \320\261\320\260\321\201\321\202\320\260\320\271\321\213\322\233!\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
