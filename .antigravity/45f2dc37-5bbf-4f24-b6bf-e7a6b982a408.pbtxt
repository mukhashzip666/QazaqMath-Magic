        instruction: "import React, { useState } from \'react\';\nimport { Sparkles, X, Binary, ArrowRight } from \'lucide-react\';\nimport { getColumnIdsForNumber, getMathFormula, MAGIC_COLUMNS } from \'../utils/magicTable\';\nimport { soundManager } from \'../utils/soundEffects\';\n\ninterface NumberTrainerProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onApplyNumber: (num: number) => void;\n}\n\nexport const NumberTrainer: React.FC<NumberTrainerProps> = ({\n  isOpen,\n  onClose,\n  onApplyNumber,\n}) => {\n  const [selectedNum, setSelectedNum] = useState<number>(13);\n\n  if (!isOpen) return null;\n\n  const activeCols = getColumnIdsForNumber(selectedNum);\n  const formulaInfo = getMathFormula(activeCols);\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm animate-in fade-in duration-200\">\n      <div className=\"w-full max-w-xl rounded-2xl glass-panel-elevated border border-cyan-500/40 p-6 shadow-2xl relative\">\n        {/* Close Button */}\n        <button\n          onClick={onClose}\n          aria-label=\"\320\226\320\260\320\261\321\203\"\n          className=\"absolute top-4 right-4 p-2 rounded-lg bg-slate-800 text-slate-400 hover:text-white transition-colors cursor-pointer\"\n        >\n          <X className=\"w-4 h-4\" />\n        </button>\n\n        {/* Title */}\n        <div className=\"flex items-center gap-2 mb-4\">\n          <div className=\"p-2 rounded-xl bg-cyan-500/20 text-cyan-300\">\n            <Sparkles className=\"w-5 h-5 text-cyan-400\" />\n          </div>\n          <div>\n            <h3 className=\"text-lg font-bold text-slate-100\">\n              \302\253\320\241\320\260\320\275\320\264\320\260\321\200 \321\202\321\200\320\265\320\275\320\260\320\266\320\265\321\200\321\226\302\273\n            </h3>\n            <p className=\"text-xs text-slate-400\">\n              1 \320\274\320\265\320\275 31 \320\260\321\200\320\260\320\273\321\213\322\223\321\213\320\275\320\264\320\260\322\223\321\213 \320\272\320\265\320\267 \320\272\320\265\320\273\320\263\320\265\320\275 \321\201\320\260\320\275\320\264\321\213 \321\202\320\260\322\243\320\264\320\260\320\277, \320\276\320\275\321\213\322\243 \320\265\320\272\321\226\320\273\321\226\320\272 \322\233\322\261\320\277\320\270\321\217\321\201\321\213\320\275 \320\272\323\251\321\200\321\226\322\243\321\226\320\267\n            </p>\n          </div>\n        </div>\n\n        {/* Number Selector / Slider */}\n        <div className=\"p-4 rounded-xl bg-slate-900/80 border border-slate-800 mb-5\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs text-slate-400 font-medium\">\320\227\320\265\321\200\321\202\321\202\320\265\320\273\320\265\321\202\321\226\320\275 \321\201\320\260\320\275:</span>\n            <span className=\"text-2xl font-bold font-mono text-cyan-300 tabular-nums\">\n              {selectedNum}\n            </span>\n          </div>\n          <input\n            type=\"range\"\n            min=\"1\"\n            max=\"31\"\n            value={selectedNum}\n            onChange={(e) => {\n              const val = Number(e.target.value);\n              setSelectedNum(val);\n              soundManager.playSelect(400 + val * 10);\n            }}\n            className=\"w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-cyan-400\"\n          />\n          <div className=\"flex justify-between text-[10px] text-slate-500 font-mono mt-1\">\n            <span>1</span>\n            <span>8</span>\n            <span>16</span>\n            <span>24</span>\n            <span>31</span>\n          </div>\n        </div>\n\n        {/* Quick Numbers grid */}\n        <div className=\"mb-5\">\n          <div className=\"text-xs text-slate-400 mb-2 font-medium\">\n            \320\226\321\213\320\273\320\264\320\260\320\274 \321\202\320\260\322\243\320\264\320\260\321\203:\n          </div>\n          <div className=\"grid grid-cols-8 sm:grid-cols-11 gap-1.5 text-center\">\n            {Array.from({ length: 31 }, (_, i) => i + 1).map((n) => (\n              <button\n                key={n}\n                onClick={() => {\n                  setSelectedNum(n);\n                  soundManager.playSelect(450 + n * 8);\n                }}\n                className={`py-1 rounded text-xs font-mono font-semibold transition-all cursor-pointer ${\n                  selectedNum === n\n                    ? \'bg-cyan-400 text-slate-950 font-bold scale-110 shadow-md\'\n                    : \'bg-slate-800/80 text-slate-300 hover:bg-slate-700\'\n                }`}\n              >\n                {n}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Binary Breakdown Result */}\n        <div className=\"p-4 rounded-xl bg-slate-950/70 border border-purple-500/30 mb-6 space-y-3\">\n          <div className=\"flex items-center justify-between text-xs font-mono\">\n            <span className=\"text-slate-400 flex items-center gap-1\">\n              <Binary className=\"w-3.5 h-3.5 text-cyan-400\" />\n              \320\225\320\272\321\226\320\273\321\226\320\272 \320\272\320\276\320\264 (5-\320\261\320\270\321\202):\n            </span>\n            <span className=\"text-amber-300 font-bold tracking-widest text-sm\">\n              {formulaInfo.binaryRepresentation}\342\202\202\n            </span>\n          </div>\n\n          <div className=\"text-sm font-mono text-cyan-200\">\n            <strong>\322\232\320\276\321\201\321\213\320\275\320\264\321\213:</strong> {formulaInfo.formulaText}\n          </div>\n\n          <div className=\"text-xs text-slate-400\">\n            \320\236\321\201\321\213 \321\201\320\260\320\275 \320\272\320\265\320\273\320\265\321\201\321\226 \320\261\320\260\322\223\320\260\320\275\320\264\320\260\321\200\320\264\320\260 \320\272\320\265\320\267\320\264\320\265\321\201\320\265\320\264\321\226:\n            <div className=\"flex flex-wrap gap-1.5 mt-1.5\">\n              {MAGIC_COLUMNS.map((col) => {\n                const isPresent = activeCols.includes(col.id);\n                return (\n                  <span\n                    key={col.id}\n                    className={`px-2 py-0.5 rounded text-[11px] font-mono ${\n                      isPresent\n                        ? \'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold\'\n                        : \'bg-slate-900 text-slate-600 border border-slate-800\'\n                    }`}\n                  >\n                    {col.title} ({col.key})\n                  </span>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n\n        {/* Apply CTA */}\n        <div className=\"flex items-center justify-end gap-3\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 rounded-xl text-xs sm:text-sm text-slate-400 hover:text-white transition-colors cursor-pointer\"\n          >\n            \320\226\320\260\320\261\321\203\n          </button>\n          <button\n            onClick={() => {\n              onApplyNumber(selectedNum);\n              onClose();\n              soundManager.playMagicReveal();\n            }}\n            className=\"px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-400 to-blue-500 text-slate-950 font-bold text-xs sm:text-sm flex items-center gap-2 hover:opacity-90 transition-opacity cursor-pointer shadow-lg shadow-cyan-500/25\"\n          >\n            <span>\320\232\320\265\321\201\321\202\320\265\320\264\320\265 \320\261\320\265\320\273\320\263\321\226\320\273\320\265\321\203</span>\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/NumberTrainer.tsx"
        }
        overwrite: true
      }
    }
