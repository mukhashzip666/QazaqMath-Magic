  console.warn(\'Gemini API call failed, using local smart response:\', geminiError);\\n        // gracefully fall back to local responses\\n      }\\n    }\\n\\n    // Fallback response\\n    const localReply = getLocalMagicianResponse(message, currentNumber, selectedKeys);\\n    res.json({ reply: localReply, source: \'local\' });\\n  } catch (error) {\\n    console.error(\'Error handling chat:\', error);\\n    res.status(500).json({ error: \'\320\241\320\265\321\200\320\262\320\265\321\200\320\264\320\265 \322\233\320\260\321\202\320\265 \320\276\321\200\321\213\320\275 \320\260\320\273\320\264\321\213\' });\\n  }\\n});\\n\\n// Configure Vite or serve static files\\nasync function startServer() {\\n  if (process.env.NODE_ENV === \'production\') {\\n    app.use(express.static(path.resolve(__dirname, \'dist\')));\\n    app.get(\'*\', (_req: Request, res: Response) => {\\n      res.sendFile(path.resolve(__dirname, \'dist\', \'index.html\'));\\n    });\\n  } else {\\n    const { createServer: createViteServer } = await import(\'vite\');\\n    const vite = await createViteServer({\\n      server: { middlewareMode: true },\\n      appType: \'spa\',\\n    });\\n    app.use(vite.middlewares);\\n  }\\n\\n  app.listen(Number(PORT), \'0.0.0.0\', () => {\\n    console.log(`\342\234\250 \302\253\320\241\320\270\322\233\321\213\321\200\320\273\321\213 \320\272\320\265\321\201\321\202\320\265\302\273 \321\201\320\265\321\200\320\262\320\265\321\200\321\226 \320\264\320\260\320\271\321\213\320\275: http://localhost:${PORT}`);\\n  });\\n}\\n\\nstartServer();\\n\", \"Description\":\"Create server.ts with Gemini API integration and smart local fallback\", \"Overwrite\":true, \"TargetFile\":\"/server.ts\", \"toolAction\":\"Creating server.ts\", \"toolSummary\":\"Create server.ts\"}"
      thinking_signature: "\022\201\006\n\376\005\001i\024}\023\022i\213\330\031\243\220)`W#\030\271\v\205\342e\002\366g\315\244I+=\315\266TM\216I`\325\346\230Z(\342\372 \343M\277\230m\210\370\321\362\004X\f\272\016\002\256\261\376\256D\0204\365\366\177\256j\315G3\033\210f\370\347%\340\347\314~\354\346\270\350\205\231\033\002\264\026\247$6\313!\003\257R\231\235\333-\224T.\020\r\330\312\244\333D\223\341\267\365\206\234LJ;{*\207Z|\375\030C\367<\344\023{\231\327\304\245\343K%q\312\351H*\202\242\304E2\236|\325\a\364\0215F\334l\017M\261D\363]orM\000\204\260\340\3674\257\204w\324\377\225nj\346\3736\303j7&\271\bz\325\200\003q\032BZ\fk\250$X\371\347\a0^\200g\215\022?|_\216\b\225G\353\357\37695\301:en[\b\026\367\\\022\032\'\273Y\330\244RR\346j\nC\267\215\243m\"\0018\206\336\351\332\314\376/\243o.\200@\255^\v\032\217\336\314\337\244\004!\306~\313}P\032\233D\271\346\033]d\310\201N\276\345\005\263\310\177\neFf\025\361.\277w\240\335A\001\256\027\344\325+\312\347\035\211]\227\000\002_\v\351\363\254An\343\350\004\357\234\224_\237\376{= Hx\240\343P\231\357E=8#\206X\332\301\310\272\035\273\001:\033#\211\274v\314\222:\267\341\375\356R\3547\225;\'-\001\037\314\2547\023Pi\320UVe\263\277~/\032\255IS\031\270\250\214o\200\267\n[~+\327\265\332YO\235\375\306N\335.V\025P\214\320\032\235x\002#\212\234\202a\334\273_\321\036?\237\214V\221V\237\302\a\006\255\350\246\367\205\226\346S\267y.p\277sw\247M\a\317\306\022b\331\332\206\n\226\247!#J\314\277M\260\272\312\273=\000\273\275\031\247\341\341A)\337\377\231zk\207\272\262\350\317\272\306{\000;c\363\3339\202\004x\234\227K\336\036\023o\355\2226\305\373l85^\310vr\262E\317\262\221-Ayl\030\376tN\271\270V\002z\031A\213\263X9\345\004\373lb\314\323\317\3513\250\342\214WW$\326z\264M\323M}\2503\025\264\272\n\366\000\357W\374<\270[\357f\335!w\017oj\000\037p\003\226\020me\\\306$2\273\235\232[uv\3749\027\004\025\033\210\337d\337\024\211\312bdi\347\n\376\346\261W\244L\360\202a}\"e\351\375/\207\036\264O\242y\235K\\&\220R\314\276\271$%\264\375\274\254\347q\335\33