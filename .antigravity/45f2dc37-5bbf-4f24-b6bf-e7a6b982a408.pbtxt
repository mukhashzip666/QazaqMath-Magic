      thinking_signature: "\022\340\020\n\335\020\001i\024}\023\275\236[\326\304\2223\371\200\206_3\002\334(\376\233\"\3106\324\331DH\2244\256O\033\2020,R\235\017\357\210\367*\377\232\370s\033D\343\r]\017\276\352\322,x\365\220E\233\231\311\216\305\ve\301\261\350\227\243\3267\357u\f\226?\236M\272\020\217\034\257\321.\213%V\306@\262\330\365DD\371$\270\236\034h`\306%\357,\331\222\223\003\236\b(D;\344\365\222\t\246\226\375$^\304\237a\2562P8\0002\271\036\263s\256\035i\313\211\030\365\302\031o$\254\352[\350V08w\270 \221V\034U\n|5=\3209(z\267\352.Gh\263\324\033Ju|R\235\334\221G\213\246\310f\275k\243\f\n\224F\265\232v\r\242\212K`\324\234%\203r\334\217&\3604\034\\\374\"\323\335\313\225\214\315\323!\004%\300\256\237\272\303\234\353\035O\225F\230\314Q\3243g\352\367\276\035f(\'\327V\205\267\366\212\312\242ZVM\266\267U\210|g\361s\004\362&\375\\\340\304&\327\036\220-\023\327\216\344\003\n\373L\253\227D\234Z^\327\221.\217\004\242`\207\032U\204!\325\005M\367\v\362\304\350\267\210-h$\210\254v\342\272\344\315x\335\335\204]\274m\211\273M\315\302\322\314\337_\203%t\006;_\346/Q\305\352$\323KS/r\034\235\335\257,-8\263f\322*@\360\247\a\f*\260P\365gF[~\311\243\324\342*\353\354;e\3630\024\252\337CI\226\326\035\264\3623\025\304T\ve^\307\267\032\363?\215\272B*\242*\277\367\336\246I\341\t\374\214\r\274\225\255\227\260\273\024\177\205\254\307\261\027\354\242\350\360\266<\021\245d\305\360e\223\321\210\303\356O\221x\360\345r\276\370j\360\305h]\361\274\t\216t\334\2433\037\211w\203W\250\3214\2617Q\236\203\236\034\205?\266\355\250\371\250\371\362*\324A\020\242+\362\211l\026\234\267Q\244\027Gr\225K\335\254\206`=\325\271\223\356\320w\360B&\237`\230\211\261\302\201\251\261\222y-\224\266U\330\333cj\221c\241Tu\357F\364\215v\301\215\017\330\f@\\\211q\236d\005\377e\305<\247\316\226&D>\216\366C\217\036\221\370\252\303R\001\303\210E\207\332\241\r\004s\211Xi\347\267g\262\307\031\031\333\303b\300E\366\242\016\221\240.D\224\257\000\250\362M\361\'\256\346\023\255MJ\377Yn\206J\242\354\273\004\227L\365\2720yN\342\