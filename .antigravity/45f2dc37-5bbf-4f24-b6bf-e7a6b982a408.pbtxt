  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \'react\';\nimport { Header } from \'./components/Header\';\nimport { InstructionBanner } from \'./components/InstructionBanner\';\nimport { MagicTable } from \'./components/MagicTable\';\nimport { ActionControls } from \'./components/ActionControls\';\nimport { SecretExplanationCard } from \'./components/SecretExplanationCard\';\nimport { VirtualMagicianChat, ChatMessage } from \'./components/VirtualMagicianChat\';\nimport { NumberTrainer } from \'./components/NumberTrainer\';\nimport { RulesModal } from \'./components/RulesModal\';\nimport { \n  calculateGuessedNumber, \n  getColumnIdsForNumber, \n  getMathFormula \n} from \'./utils/magicTable\';\nimport { soundManager } from \'./utils/soundEffects\';\n\nexport default function App() {\n  const [selectedColumnIds, setSelectedColumnIds] = useState<number[]>([]);\n  const [guessedNumber, setGuessedNumber] = useState<number | null>(null);\n  const [isSecretRevealed, setIsSecretRevealed] = useState<boolean>(false);\n  const [isMuted, setIsMuted] = useState<boolean>(false);\n  const [showTrainer, setShowTrainer] = useState<boolean>(false);\n  const [showRules, setShowRules] = useState<boolean>(false);\n  const [highlightedNumber, setHighlightedNumber] = useState<number | null>(null);\n  const [isGenerating, setIsGenerating] = useState<boolean>(false);\n\n  // Initial Magician Chat Greeting in Kazakh\n  const [messages, setMessages] = useState<ChatMessage[]>([\n    {\n      id: \'init-1\',\n      sender: \'magician\',\n      text: \'\320\241\323\231\320\273\320\265\320\274, \322\233\321\213\320\274\320\261\320\260\321\202\321\202\321\213 \320\264\320\276\321\201\321\213\320\274! \360\237\216\251\342\234\250 \320\234\320\265\320\275 \342\200\224 \320\274\320\260\321\202\320\265\320\274\320\260\321\202\320\270\320\272\320\260 \321\201\320\270\322\233\321\213\321\200\321\210\321\213\321\201\321\213\320\274\321\213\320\275.\\n\\n1 \320\274\320\265\320\275 31 \320\260\321\200\320\260\320\273\321\213\322\223\321\213\320\275\320\264\320\260\322\223\321\213 \320\272\320\265\320\267 \320\272\320\265\320\273\320\263\320\265\320\275 \320\261\321\226\321\200 \321\201\320\260\320\275\320\264\321\213 \320\276\320\271\320\273\320\260\320\277, \320\276\320\273 \320\272\320\265\320\267\320\264\320\265\321\201\320\265\321\202\321\226\320\275 \320\261\320\260\322\223\320\260\320\275\320\264\320\260\321\200\320\264\321\213 \321\202\323\251\320\274\320\265\320\275\320\264\320\265\320\263\321\226 \302\253\320\234\320\265\320\275\321\226\322\243 \321\201\320\260\320\275\321\213\320\274 \320\276\321\201\321\213\320\275\320\264\320\260\302\273 \321\202\322\257\320\271\320\274\320\265\321\201\321\226\320\274\320\265\320\275 \320\261\320\265\320\273\320\263\321\226\320\273\320\265. \320\241\320\276\321\201\321\213\320\275 \302\253\320\241\320\260\320\275\320\264\321\213 \320\261\321\226\320\273\321\203 \342\234\250\302\273 \320\261\320\260\321\202\321\213\321\200\320\274\320\260\321\201\321\213\320\275 \320\261\320\260\321\201!\',\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    },\n  ]);\n\n  // Toggle audio mute\n  const handleToggleMute = () => {\n    const nextMuted = !isMuted;\n    setIsMuted(nextMuted);\n    soundManager.isMuted = nextMuted;\n  };\n\n  // Toggle column selection\n  const handleToggleColumn = (columnId: number) => {\n    setSelectedColumnIds((prev) => {\n      const exists = prev.includes(columnId);\n      const updated = exists ? prev.filter((id) => id !== columnId) : [...prev, columnId];\n      return updated;\n    });\n    // clear highlight when user clicks manually\n    setHighlightedNumber(null);\n  };\n\n  // Step 1: \302\253\320\241\320\260\320\275\320\264\321\213 \320\261\321\226\320\273\321\203 \342\234\250\302\273\n  const handleRevealNumber = () => {\n    if (selectedColumnIds.length === 0) {\n      const now = new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' });\n      setMessages((prev) => [\n        ...prev,\n        {\n          id: `warn-${Date.now()}`,\n          sender: \'magician\',\n          text: \'\320\241\320\265\320\275 \323\231\320\273\321\226 \320\265\321\210\320\261\321\226\321\200 \320\261\320\260\322\223\320\260\320\275\320\264\321\213 \321\202\320\260\322\243\320\264\320\260\320\274\320\260\320\264\321\213\322\243 \322\223\320\276\320\271! \360\237\224\256\\n1 \320\274\320\265\320\275 31 \320\260\321\200\320\260\320\273\321\213\322\223\321\213\320\275\320\264\320\260\322\223\321\213 \320\272\320\265\320\267 \320\272\320\265\320\273\320\263\320\265\320\275 \320\261\321\226\321\200 \321\201\320\260\320\275\320\264\321\213 \320\265\321\201\321\226\322\243\320\265 \321\201\320\260\322\233\321\202\320\260\320\277, \320\276\320\273 \320\272\320\265\320\267\320\264\320\265\321\201\320\265\321\202\321\226\320\275 \320\261\320\260\322\223\320\260\320\275\320\264\320\260\321\200\320\264\321\213 \321\202\323\251\320\274\320\265\320\275\320\264\320\265\320\263\321\226 \302\253\320\234\320\265\320\275\321\226\322\243 \321\201\320\260\320\275\321\213\320\274 \320\276\321\201\321\213\320\275\320\264\320\260\302\273 \321\202\322\257\320\271\320\274\320\265\321\201\321\226\320\274\320\265\320\275 \320\261\320\265\320\273\320\263\321\226\320\273\320\265!\',\n          timestamp: now,\n        },\n      ]);\n      return;\n    }\n\n    const calculated = calculateGuessedNumber(selectedColumnIds);\n    setGuessedNumber(calculated);\n\n    const now = new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' });\n\n    // Step 1: \302\253\320\220\320\261\321\200\320\260\320\272\320\260\320\264\320\260\320\261\321\200\320\260! \342\234\250 \320\234\320\265\320\275 \321\201\320\265\320\275\321\226\322\243 \320\276\320\271\321\213\322\243\320\264\321\213 \320\276\322\233\321\213\320\264\321\213\320\274...\302\273\n    // Step 2: \302\253\320\221\322\261\320\273 \321\204\320\276\320\272\321\203\321\201\321\202\321\213\322\243 \322\233\320\260\320\273\320\260\320\271 \320\266\322\261\320\274\321\213\321\201 \321\226\321\201\321\202\320\265\320\271\321\202\321\226\320\275\321\226\320\275 \320\261\321\226\320\273\320\263\321\226\322\243 \320\272\320\265\320\273\320\265 \320\274\320\265?\302\273 with quick action button\n    const revealMessage: ChatMessage = {\n      id: `reveal-${Date.now()}`,\n      sender: \'magician\',\n      text: `\320\220\320\261\321\200\320\260\320\272\320\260\320\264\320\260\320\261\321\200\320\260! \342\234\250 \320\234\320\265\320\275 \321\201\320\265\320\275\321\226\322\243 \320\276\320\271\321\213\322\243\320\264\321\213 \320\276\322\233\321\213\320\264\321\213\320\274.\\n\320\241\320\265\320\275 ${calculated} \321\201\320\260\320\275\321\213\320\275 \320\276\320\271\320\273\320\260\320\264\321\213\322\243!\\n\\n\320\221\322\261\320\273 \321\204\320\276\320\272\321\203\321\201\321\202\321\213\322\243 \322\233\320\260\320\273\320\260\320\271 \320\266\322\261\320\274\321\213\321\201 \321\226\321\201\321\202\320\265\320\271\321\202\321\226\320\275\321\226\320\275 \320\261\321\226\320\273\320\263\321\226\322\243 \320\272\320\265\320\273\320\265 \320\274\320\265?`,\n      quickAction: {\n        type: \'reveal_secret\',\n        label: \'\320\230\323\231, \322\233\322\261\320\277\320\270\321\217\321\201\321\213\320\275 \320\260\321\210! \360\237\224\223\',\n      },\n      timestamp: now,\n    };\n\n    setMessages((prev) => [...prev, revealMessage]);\n  };\n\n  // Step 3: \302\253\320\230\323\231, \322\233\322\261\320\277\320\270\321\217\321\201\321\213\320\275 \320\260\321\210! \360\237\224\223\302\273\n  const handleRevealSecret = () => {\n    setIsSecretRevealed(true);\n    const calculated = guessedNumber ?? calculateGuessedNumber(selectedColumnIds);\n    const formulaInfo = getMathFormula(selectedColumnIds);\n    const now = new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' });\n\n    const explanationMessage: ChatMessage = {\n      id: `secret-${Date.now()}`,\n      sender: \'magician\',\n      text: `\322\232\322\261\320\277\320\270\321\217 \320\260\321\210\321\213\320\273\320\264\321\213! \360\237\224\223\342\234\250\\n\\n\320\221\322\261\320\273 \321\201\320\270\322\233\321\213\321\200\320\264\321\213\322\243 \322\233\322\261\320\277\320\270\321\217\321\201\321\213 2-\320\275\321\226\322\243 \320\264\323\231\321\200\320\265\320\266\320\265\320\273\320\265\321\200\321\226\320\275\320\265 (16, 8, 4, 2, 1) \320\266\323\231\320\275\320\265 \320\265\320\272\321\226\320\273\321\226\320\272 \321\201\320\260\320\275\320\260\321\203 \320\266\322\257\320\271\320\265\321\201\321\226\320\275\320\265 (binary system) \320\275\320\265\320\263\321\226\320\267\320\264\320\265\320\273\320\263\320\265\320\275!\\n\\n${\n        calculated > 0\n          ? `\320\241\320\265\320\275 \320\276\320\271\320\273\320\260\322\223\320\260\320\275 ${calculated} \321\201\320\260\320\275\321\213 \320\264\323\231\320\273 \320\276\321\201\321\213 \320\272\321\226\320\273\321\202\321\202\320\265\321\200\320\264\321\226\322\243 \322\233\320\276\321\201\321\213\320\275\320\264\321\213\321\201\321\213\320\275\320\260\320\275 \321\202\322\261\321\200\320\260\320\264\321\213:\\n\360\237\221\211 ${formulaInfo.formulaText}\\n(\320\265\320\272\321\226\320\273\321\226\320\272 \320\266\322\257\320\271\320\265\320\264\320\265: ${formulaInfo.binaryRepresentation}\342\202\202)\\n\\n`\n          : \'\'\n      }\320\232\320\276\320\274\320\277\321\214\321\216\321\202\320\265\321\200\320\273\320\265\321\200 \320\264\320\265 \320\264\323\231\320\273 \320\276\321\201\321\213 \320\277\321\200\320\270\320\275\321\206\320\270\320\277\320\277\320\265\320\275 (0 \320\266\323\231\320\275\320\265 1) \320\266\322\261\320\274\321\213\321\201 \321\226\321\201\321\202\320\265\320\271\320\264\321\226. \323\230\321\200 \320\261\320\260\322\223\320\260\320\275\320\264\321\213 \320\261\320\265\320\273\320\263\321\226\320\273\320\265\321\203 \342\200\224 1 \320\261\320\270\321\202 \320\260\322\233\320\277\320\260\321\200\320\260\321\202\321\202\321\213 \322\233\320\276\321\201\321\203\320\274\320\265\320\275 \321\202\320\265\322\243!\\n\\n\322\232\320\276\321\201\321\213\320\274\321\210\320\260 \321\201\322\261\321\200\320\260\322\233\321\202\320\260\321\200\321\213\322\243 \320\261\320\276\320\273\321\201\320\260, \321\202\323\251\320\274\320\265\320\275\320\264\320\265 \320\274\320\265\320\275\320\265\320\275 \321\201\322\261\321\200\320\260\320\277 \320\272\323\251\321\200!`,\n      timestamp: now,\n    };\n\n    setMessages((prev) => [...prev, explanationMessage]);\n  };\n\n  // Reset: \302\253\322\232\320\260\320\271\321\202\320\260 \320\261\320\260\321\201\321\202\320\260\321\203 \360\237\224\204\302\273\n  const handleReset = () => {\n    setSelectedColumnIds([]);\n    setGuessedNumber(null);\n    setHighlightedNumber(null);\n    const now = new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' });\n\n    setMessages((prev) => [\n      ...prev,\n      {\n        id: `reset-${Date.now()}`,\n        sender: \'magician\',\n        text: \'\320\226\320\260\322\243\320\260 \320\276\320\271\321\213\320\275 \320\261\320\260\321\201\321\202\320\260\320\273\320\264\321\213! \360\237\224\204 1 \320\274\320\265\320\275 31 \320\260\321\200\320\260\320\273\321\213\322\223\321\213\320\275\320\264\320\260 \320\266\320\260\322\243\320\260 \320\261\321\226\321\200 \321\201\320\260\320\275\320\264\321\213 \320\276\320\271\320\273\320\260\320\277, \320\276\320\273 \320\261\320\260\321\200 \320\261\320\260\322\223\320\260\320\275\320\264\320\260\321\200\320\264\321\213 \320\261\320\265\320\273\320\263\321\226\320\273\320\265!\',\n        timestamp: now,\n      },\n    ]);\n  };\n\n  // Apply number from Trainer\n  const handleApplyTrainerNumber = (num: number) => {\n    const colIds = getColumnIdsForNumber(num);\n    setSelectedColumnIds(colIds);\n    setGuessedNumber(num);\n    setHighlightedNumber(num);\n\n    const now = new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' });\n    const formulaInfo = getMathFormula(colIds);\n\n    setMessages((prev) => [\n      ...prev,\n      {\n        id: `trainer-${Date.now()}`,\n        sender: \'magician\',\n        text: `\360\237\216\257 \320\242\321\200\320\265\320\275\320\260\320\266\320\265\321\200\320\264\320\265\320\275 ${num} \321\201\320\260\320\275\321\213 \322\233\320\276\320\273\320\264\320\260\320\275\321\213\320\273\320\264\321\213!\\n\320\236\320\273 \320\274\321\213\320\275\320\260 \320\261\320\260\322\223\320\260\320\275\320\264\320\260\321\200\320\264\320\260 \320\261\320\260\321\200: ${colIds.map((c) => `${c}-\320\261\320\260\322\223\320\260\320\275`).join(\', \')}.\\n\322\232\320\276\321\201\321\213\320\275\320\264\321\213: ${formulaInfo.formulaText}`,\n        timestamp: now,\n      },\n    ]);\n  };\n\n  // Send question to Magician (Gemini API with smart local fallback)\n  const handleSendMessage = async (text: string) => {\n    const now = new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' });\n    \n    // Add user message\n    const userMsg: ChatMessage = {\n      id: `user-${Date.now()}`,\n      sender: \'user\',\n      text,\n      timestamp: now,\n    };\n    setMessages((prev) => [...prev, userMsg]);\n    setIsGenerating(true);\n\n    try {\n      const currentNum = guessedNumber ?? calculateGuessedNumber(selectedColumnIds);\n      const formulaInfo = getMathFormula(selectedColumnIds);\n\n      const response = await fetch(\'/api/magician/chat\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          message: text,\n          currentNumber: currentNum > 0 ? currentNum : undefined,\n          selectedKeys: formulaInfo.selectedKeys,\n        }),\n      });\n\n      if (!response.ok) {\n        throw new Error(\'API request failed\');\n      }\n\n      const data = await response.json();\n      const replyText = data.reply || \'\342\234\250 \320\241\320\270\322\233\321\213\321\200\320\273\321\213 \320\272\320\265\321\201\321\202\320\265 \321\202\321\203\321\200\320\260\320\273\321\213 \321\202\320\260\322\223\321\213 \320\275\320\265 \320\261\321\226\320\273\320\263\321\226\322\243\321\226\320\267 \320\272\320\265\320\273\320\265\320\264\321\226?\';\n\n      setMessages((prev) => [\n        ...prev,\n        {\n          id: `magician-${Date.now()}`,\n          sender: \'magician\',\n          text: replyText,\n          timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n        },\n      ]);\n    } catch (err) {\n      console.warn(\'Chat request failed, using local fallback:\', err);\n      // Graceful fallback\n      setMessages((prev) => [\n        ...prev,\n        {\n          id: `magician-err-${Date.now()}`,\n          sender: \'magician\',\n          text: \'\342\234\250 \320\244\320\276\320\272\321\203\321\201\321\202\321\213\322\243 \320\275\320\265\320\263\321\226\320\267\320\263\321\226 \321\201\321\213\321\200\321\213 \342\200\224 \320\265\320\272\321\226\320\273\321\226\320\272 \320\266\322\257\320\271\320\265\320\264\320\265 (16, 8, 4, 2, 1). 1-\320\264\320\265\320\275 31-\320\263\320\265 \320\264\320\265\320\271\321\226\320\275\320\263\321\226 \320\272\320\265\320\267 \320\272\320\265\320\273\320\263\320\265\320\275 \321\201\320\260\320\275\320\264\321\213 \320\276\321\201\321\213 5 \321\201\320\260\320\275\320\275\321\213\322\243 \322\233\320\276\321\201\321\213\320\275\320\264\321\213\321\201\321\213 \321\202\322\257\321\200\321\226\320\275\320\264\320\265 \320\261\321\226\321\200 \322\223\320\260\320\275\320\260 \321\202\323\231\321\201\321\226\320\273\320\274\320\265\320\275 \320\272\323\251\321\200\321\201\320\265\321\202\321\203\320\263\320\265 \320\261\320\276\320\273\320\260\320\264\321\213!\',\n          timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n        },\n      ]);\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#070b14] text-slate-100 flex flex-col\">\n      {/* Header */}\n      <Header\n        isMuted={isMuted}\n        onToggleMute={handleToggleMute}\n        showTrainer={showTrainer}\n        onToggleTrainer={() => setShowTrainer(true)}\n        onOpenRules={() => setShowRules(true)}\n      />\n\n      {/* Main Container */}\n      <main className=\"grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full\">\n        {/* Instruction Banner */}\n        <InstructionBanner />\n\n        {/* 2-Zone Workspace Split: Left (Stage & Controls) + Right (Virtual Magician Chat) */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n          {/* Left Zone: The Magic Table + Controls + Explanation Card */}\n          <section className=\"lg:col-span-8 flex flex-col\">\n            {/* The 5 Columns Magic Table */}\n            <MagicTable\n              selectedColumnIds={selectedColumnIds}\n              onToggleColumn={handleToggleColumn}\n              isSecretRevealed={isSecretRevealed}\n              highlightedNumber={highlightedNumber}\n            />\n\n            {/* Action Buttons */}\n            <ActionControls\n              onRevealNumber={handleRevealNumber}\n              onReset={handleReset}\n              isSecretRevealed={isSecretRevealed}\n              onToggleSecret={() => setIsSecretRevealed(!isSecretRevealed)}\n              hasSelection={selectedColumnIds.length > 0}\n            />\n\n            {/* Secret Mathematical Explanation Card (shown when secret is unlocked or manually toggled) */}\n            {isSecretRevealed && (\n              <SecretExplanationCard\n                selectedColumnIds={selectedColumnIds}\n                guessedNumber={guessedNumber}\n              />\n            )}\n          </section>\n\n          {/* Right Zone: Virtual Magician Chat Assistant */}\n          <aside className=\"lg:col-span-4 sticky top-20\">\n            <VirtualMagicianChat\n              messages={messages}\n              onSendMessage={handleSendMessage}\n              onRevealSecret={handleRevealSecret}\n              isGenerating={isGenerating}\n              isSecretRevealed={isSecretRevealed}\n            />\n          </aside>\n        </div>\n      </main>\n\n      {/* Modals */}\n      <NumberTrainer\n        isOpen={showTrainer}\n        onClose={() => setShowTrainer(false)}\n        onApplyNumber={handleApplyTrainerNumber}\n      />\n\n      <RulesModal\n        isOpen={showRules}\n        onClose={() => setShowRules(false)}\n      />\n\n      {/* Footer */}\n      <footer className=\"mt-auto border-t border-slate-900 bg-[#060911] py-5 text-center text-xs text-slate-500\">\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2\">\n          <span>\302\253\320\241\320\270\322\233\321\213\321\200\320\273\321\213 \320\272\320\265\321\201\321\202\320\265\302\273 \342\200\224 \320\230\320\275\321\202\320\265\321\200\320\260\320\272\321\202\320\270\320\262\321\202\321\226 \320\274\320\260\321\202\320\265\320\274\320\260\321\202\320\270\320\272\320\260\320\273\321\213\322\233 \320\261\321\226\320\273\321\226\320\274 \320\261\320\265\321\200\321\203 \322\233\320\276\321\201\321\213\320\274\321\210\320\260\321\201\321\213</span>\n          <span className=\"text-slate-600 font-mono\">\320\225\320\272\321\226\320\273\321\226\320\272 \321\201\320\260\320\275\320\260\321\203 \320\266\322\257\320\271\320\265\321\201\321\226 \302\267 2\342\201\260 + 2\302\271 + 2\302\262 + 2\302\263 + 2\342\201\264</span>\n        </div>\n      </footer>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/App.tsx"
        }
        overwrite: true
      }
    }
