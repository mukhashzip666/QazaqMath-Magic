    tool_calls {
      id: "call_455468"
      name: "write_to_file"
      arguments_json: "{\"Append\":false, \"CodeContent\":\"import React from \'react\';\\nimport { Sparkles, RotateCcw, Unlock, Lock } from \'lucide-react\';\\nimport { soundManager } from \'../utils/soundEffects\';\\n\\ninterface ActionControlsProps {\\n  onRevealNumber: () => void;\\n  onReset: () => void;\\n  isSecretRevealed: boolean;\\n  onToggleSecret: () => void;\\n  hasSelection: boolean;\\n}\\n\\nexport const ActionControls: React.FC<ActionControlsProps> = ({\\n  onRevealNumber,\\n  onReset,\\n  isSecretRevealed,\\n  onToggleSecret,\\n  hasSelection,\\n}) => {\\n  return (\\n    <div className=\\\"flex flex-wrap items-center justify-center gap-3 sm:gap-4 my-6\\\">\\n      {/* Primary 1: \302\253\320\241\320\260\320\275\320\264\321\213 \320\261\321\226\320\273\321\203 \342\234\250\302\273 */}\\n      <button\\n        type=\\\"button\\\"\\n        onClick={() => {\\n          onRevealNumber();\\n          soundManager.playMagicReveal();\\n        }}\\n        className=\\\"px-6 sm:px-8 py-3.5 rounded-xl font-bold text-sm sm:text-base text-slate-950 bg-gradient-to-r from-amber-300 via-cyan-300 to-cyan-400 hover:from-amber-200 hover:to-cyan-300 shadow-xl shadow-cyan-500/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0 flex items-center gap-2 cursor-pointer magic-glow-cyan\\\"\\n      >\\n        <Sparkles className=\\\"w-5 h-5 text-slate-950 fill-current animate-spin\\\" style={{ animationDuration: \'6s\' }} />\\n        <span>\320\241\320\260\320\275\320\264\321\213 \320\261\321\226\320\273\321\203 \342\234\250</span>\\n      </button>\\n\\n      {/* Primary 2: \302\253\322\232\320\260\320\271\321\202\320\260 \320\261\320\260\321\201\321\202\320\260\321\203 \360\237\224\204\302\273 */}\\n      <button\\n        type=\\\"button\\\"\\n        onClick={() => {\\n          onReset();\\n          soundManager.playReset();\\n        }}\\n        className=\\\"px-5 sm:px-6 py-3.5 rounded-xl font-medium text-sm sm:text-base text-slate-300 hover:text-white bg-slate-900/90 hover:bg-slate-800 border border-slate-700/80 transition-all flex items-center gap-2 cursor-pointer\\\"\\n      >\\n        <RotateCcw className=\\\"w-4 h-4 text-slate-400\\\" />\\n        <span>\322\232\320\260\320\271\321\202\320\260 \320\261\320\260\321\201\321\202\320\260\321\203 \360\237\224\204</span>\\n      </button>\\n\\n      {/* Secret Reveal Toggle: \302\253\322\232\322\261\320\277\320\270\321\217\320\275\321\213 \320\260\321\210\321\203 \360\237\224\223\302\273 */}\\n      <button\\n        type=\\\"button\\\"\\n        onClick={() => {\\n          onToggleSecret();\\n          if (!isSecretRevealed) {\\n            soundManager.playSecretUnlock();\\n          }\\n        }}\\n        className={`px-5 py-3.5 rounded-xl font-medium text-xs sm:text-sm border transition-all flex items-center gap-2 cursor-pointer ${\\n          isSecretRevealed\\n            ? \'bg-amber-500/20 border-amber-400/60 text-amber-200 shadow-lg shadow-amber-500/20\'\\n            : \'bg-purple-950/40 hover:bg-purple-900/40 border-purple-800/60 text-purple-200\'\\n        }`}\\n      >\\n        {isSecretRevealed ? (\\n          <>\\n            <Lock className=\\\"w-4 h-4 text-amber-400\\\" />\\n            <span>\322\232\322\261\320\277\320\270\321\217\320\275\321\213 \320\266\320\260\321\201\321\213\321\200\321\203</span>\\n          </>\\n        ) : (\\n          <>\\n            <Unlock className=\\\"w-4 h-4 text-purple-400\\\" />\\n            <span>\322\232\322\261\320\277\320\270\321\217\320\275\321\213 \320\260\321\210\321\203 \360\237\224\223</span>\\n          </>\\n        )}\\n      </button>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create ActionControls component with primary buttons in Kazakh\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ActionControls.tsx\", \"toolAction\":\"Creating ActionControls.tsx\", \"toolSummary\":\"Create ActionControls.tsx component\"}"
